FROM node:22-slim AS builder

# Patch OS packages from Debian security repos (fixes perl-base CVE-2026-8376,
# CVE-2026-13221, CVE-2026-42496 — perl-base >= 5.36.0-7+deb12u4)
RUN apt-get update -qq && \
    apt-get upgrade -y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" && \
    rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest-10 --activate
WORKDIR /app

COPY . .
RUN rm -f pnpm-lock.yaml && pnpm install
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
RUN BASE_PATH=/ NODE_ENV=production \
    VITE_SUPABASE_URL="$VITE_SUPABASE_URL" \
    VITE_SUPABASE_ANON_KEY="$VITE_SUPABASE_ANON_KEY" \
    pnpm --filter @workspace/app run build

FROM nginx:alpine AS runner
ENV PORT=7860 \
    BACKEND_URL=http://api-server:3001 \
    NGINX_ENVSUBST_FILTER="^(BACKEND_URL|PORT)$"

COPY --from=builder /app/artifacts/app/dist/public/ /usr/share/nginx/html/
COPY deploy/frontend/nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 7860
