# Copy this file to .env and replace the values with your own secrets.
# This repo keeps ONE env file (the root .env). It is gitignored, so secrets
# stay out of version control. The API server loads it via dotenv, and Vite
# loads it (via envDir) for the frontend's build-time VITE_* variables.
#
# PORT and supabase vars are optional locally (the app has fallbacks); on a
# deployed server (Railway / Docker / Octopus) they come from the platform.
PORT=
# Optional. If set, visitors must enter this password on the login screen.
# If unset, no login screen is shown.
PASSWORD=
# Recommended. Session signing secret — rotate on breach.
SESSION_SECRET=
# Optional. Only needed for server-side Supabase calls (bans, device registry).
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Used to hash device IDs for the device-ban feature.
DEVICE_ID_HMAC_SECRET=
# Build-time for the frontend; group these three together.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PROJECT_ID=
# Optional. Only needed for `pnpm --filter @workspace/db push` (drizzle-kit).
DATABASE_URL=