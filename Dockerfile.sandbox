FROM node:22-slim AS builder

RUN apt-get update -qq && \
    apt-get upgrade -y -qq -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" && \
    rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@latest-10 --activate
WORKDIR /app

COPY . .
RUN rm -f pnpm-lock.yaml && pnpm install
RUN BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/mockup-sandbox run build

FROM nginx:alpine AS runner
ENV PORT=8080 \
    NGINX_ENVSUBST_FILTER="^PORT$"

COPY --from=builder /app/artifacts/mockup-sandbox/dist/ /usr/share/nginx/html/
COPY deploy/sandbox/nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 8080
